.venv/
__pycache__/
.pytest_cache/
save.json
.coverage
coverage.xml
*.egg-info/
characters.json
accounts.json
codeforge.db
codeforge.db.bak*
*.db.bak*
backups/
*.kdbx

# Dated security-patch audit reports (evidence trail; regenerated by `make patch`).
security-evidence/

# Dated ARC runtime-dimension verdicts (evidence trail; regenerated by `make arc-verdicts`).
arc-evidence/

# Exported runtime dependency set for the blocking CVE gate (regenerated by `make audit-runtime`).
runtime-requirements.txt

# Runtime Workshop outputs (generated, reproducible); keep the README tracked.
reports/*
!reports/README.md

# Generated cast sandbox (dry-run output; a cast becomes its own repo elsewhere)
casts/

# Local secrets/config: only .env.example (placeholders) is ever tracked.
.env

# Built docs site (regenerated by `make docs-build` / the Pages workflow).
site/

# The Foundry sandbox: generated candidate files (never promoted automatically).
workspace/

# The area bench: generated areas (reproducible from seed, mutable dev state); keep the README.
world_areas/*
!world_areas/README.md

# setuptools build artifacts (from a local pip install/build)
build/

# cosmic-ray mutation-testing session db (on-demand `make mutation`; reproducible from cosmic-ray.toml)
.cosmic-ray-session.sqlite

# Rust native extensions (build artifacts; keep Cargo.lock for reproducibility)
native/*/target/
**/*.rs.bk

# Go service organs (the compiled edge binary; keep go.mod for reproducibility)
native/edge/codeforge-edge

# Protocol spine: generated bindings (rebuilt via `make proto`; keep the .proto source + go.sum)
proto/telemetry_pb2.py
proto/*_pb2.pyi
native/spine/telemetrypb/
native/spine/xcheck/xcheck

# C text kernel (build artifacts; keep the source in native/textkernel/src)
native/textkernel/build/
native/textkernel/*.so
native/textkernel/*.egg-info/

# Runtime audit ledger (tamper-evident admin/economy log; reproducible, not tracked)
audit.jsonl
