[importlinter]
root_packages =
    kernel
    adapters
    content

[importlinter:contract:kernel-purity]
name = Kernel imports nothing from adapters or content (one-way dependency direction)
type = forbidden
source_modules =
    kernel
forbidden_modules =
    adapters
    content

[importlinter:contract:content-is-data]
name = Content imports no code layer (it is data)
type = forbidden
source_modules =
    content
forbidden_modules =
    kernel
    adapters

[importlinter:contract:grammar-before-worlds]
name = Seed Kernel imports no game module (grammar before worlds; the platform is domain-neutral)
type = forbidden
source_modules =
    kernel.seedlab
forbidden_modules =
    kernel.world

[importlinter:contract:platform-imports-no-domain-module]
name = Seed Kernel imports no domain module (domains register themselves; the platform never imports one)
type = forbidden
source_modules =
    kernel.seedlab
forbidden_modules =
    kernel.domains
